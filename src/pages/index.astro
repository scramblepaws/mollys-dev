---
import Layout from "../layouts/Layout.astro";
import Icon from "../components/Icon.astro";
import { site } from "../data/site";
---

<Layout title="mollys.dev">
	<section class="box">
		<div class="lbl">about / me &gt;&gt;</div>
		<p>
			<b>{site.name}</b> — trans woman ({site.pronouns})
		</p>
		<p>
			heyo, i'm molly. i really enjoy the source engine and developing cheats and
			exploits for games. feel free to check out my{" "}
			<a href="https://github.com/scramblepaws">github repos</a>.
		</p>
	</section>

	<section class="box" id="interests">
		<div class="lbl">interests &gt;&gt;</div>
		<div class="int-grid">
			<div class="int-block">
				<div class="int-label">imageboards</div>
				{site.imageboards.map((b) => (
					<a class="chip icon-link" href={b.url}>
						<Icon name="arrow" size={10} />
						{b.name}
					</a>
				))}
			</div>
			<div class="int-block">
				<div class="int-label">cheat dev / jailbreaking / rooting</div>
				{site.cheatLinks.map((c) => (
					<a class="chip icon-link" href={c.url}>
						<Icon name="arrow" size={10} />
						{c.name}
					</a>
				))}
			</div>
			<div class="int-block">
				<div class="int-label">rhythm games</div>
				{site.rhythmGames.map((g) => (
					<a class="chip icon-link" href={g.profile}>
						<Icon name="arrow" size={10} />
						{g.name}
					</a>
				))}
			</div>
			<div class="int-block full">
				<div class="int-label">DIY HRT</div>
				<p>{site.diyHrt}</p>
			</div>
		</div>
	</section>

	<section class="box" id="contact">
		<div class="lbl">contact &gt;&gt;</div>
		<ul>
			<li>
				<Icon name="discord" size={13} /> <b>discord</b>:{" "}
				<code>{site.contact.discord}</code>
			</li>
			<li>
				<Icon name="telegram" size={13} /> <b>telegram</b>:{" "}
				<code>{site.contact.telegram}</code>
			</li>
			<li>
				<Icon name="session" size={13} /> <b>session</b>:{" "}
				<code>{site.contact.session}</code>
				<button class="btn" data-copy={site.contact.session}>[ copy ]</button>
			</li>
		</ul>
	</section>
</Layout>

<script>
	document.querySelectorAll("[data-copy]").forEach((btn) => {
		btn.addEventListener("click", async () => {
			await navigator.clipboard.writeText(btn.dataset.copy);
			btn.textContent = "[ copied ]";
			setTimeout(() => (btn.textContent = "[ copy ]"), 1500);
		});
	});
</script>
