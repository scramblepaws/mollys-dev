---
import Layout from "../layouts/Layout.astro";
import Icon from "../components/Icon.astro";
import { site } from "../data/site";
---

<Layout title="mollys.dev">
	<section class="box">
		<div class="lbl">about / me &gt;&gt;</div>
		<p>
			<b>{site.name}</b> — trans woman ({site.pronouns})
		</p>
		<p>
			heyo, i'm molly. i really enjoy the source engine and developing cheats and
			exploits for games. feel free to check out my{" "}
			<a href="https://github.com/scramblepaws">github repos</a>.
		</p>
	</section>

	<section class="box" id="interests">
		<div class="lbl">interests &gt;&gt;</div>
		<table class="int-table">
			<tr>
				<td class="int-label">imageboards</td>
				<td>
					{site.imageboards.map((b, i) => (
						<>
							{i > 0 && " · "}
							<a class="icon-link" href={b.url}>
								<Icon name="arrow" size={10} />
								{b.name}
							</a>
						</>
					))}
				</td>
			</tr>
			<tr>
				<td class="int-label">cheats</td>
				<td>
					{site.cheatLinks.map((c, i) => (
						<>
							{i > 0 && " · "}
							<a class="icon-link" href={c.url}>
								<Icon name="arrow" size={10} />
								{c.name}
							</a>
						</>
					))}
				</td>
			</tr>
			<tr>
				<td class="int-label">rhythm games</td>
				<td>
					{site.rhythmGames.map((g, i) => (
						<>
							{i > 0 && " · "}
							<a class="icon-link" href={g.profile}>
								<Icon name="arrow" size={10} />
								{g.name}
							</a>
						</>
					))}
				</td>
			</tr>
			<tr>
				<td class="int-label">diy hrt</td>
				<td>{site.diyHrt}</td>
			</tr>
		</table>
	</section>

	<section class="box" id="contact">
		<div class="lbl">contact &gt;&gt;</div>
		<ul>
			<li>
				<Icon name="discord" size={13} /> <b>discord</b>:{" "}
				<code>{site.contact.discord}</code>
			</li>
			<li>
				<Icon name="telegram" size={13} /> <b>telegram</b>:{" "}
				<code>{site.contact.telegram}</code>
			</li>
			<li>
				<Icon name="session" size={13} /> <b>session</b>:{" "}
				<code>{site.contact.session}</code>
				<button class="btn" data-copy={site.contact.session}>[ copy ]</button>
			</li>
		</ul>
	</section>

	<section class="box" id="guestbook">
		<div class="lbl">guestbook &gt;&gt;</div>
		<form class="gb-form" id="gb-form">
			<input type="text" id="gb-name" maxlength="40" placeholder="name (optional)" />
			<input class="gb-msg" type="text" id="gb-msg" maxlength="500" placeholder="leave a message..." required />
			<button class="btn" type="submit">[ sign ]</button>
		</form>
		<div id="gb-list">
			<p>loading guestbook...</p>
		</div>
	</section>
</Layout>

<script>
	const GB_URL = "https://molly-counter.femfus.workers.dev";
	const listEl = document.getElementById("gb-list");
	const form = document.getElementById("gb-form");
	const nameEl = document.getElementById("gb-name");
	const msgEl = document.getElementById("gb-msg");

	const el = (tag, cls, children, text) => {
		const node = document.createElement(tag);
		if (cls) node.className = cls;
		if (children) for (const c of children) node.appendChild(c);
		if (text) node.textContent = text;
		return node;
	};

	const render = (entries) => {
		if (!entries.length) {
			listEl.replaceChildren(el("p", null, null, "no entries yet. be the first!"));
			return;
		}
		listEl.replaceChildren(
			...entries.map((e) => {
				const meta = el("div", "gb-meta");
				meta.appendChild(el("b", null, null, e.name));
				meta.appendChild(document.createTextNode(" — " + new Date(e.ts).toISOString().slice(0, 10)));
				const body = el("p", null, null, e.msg);
				return el("div", "gb-entry", [meta, body]);
			})
		);
	};

	const load = async () => {
		try {
			const r = await fetch(GB_URL + "/list");
			render(await r.json());
		} catch {
			listEl.replaceChildren(el("p", null, null, "guestbook offline :("));
		}
	};

	form.addEventListener("submit", async (e) => {
		e.preventDefault();
		const msg = msgEl.value.trim();
		if (!msg) return;
		const btn = form.querySelector("button");
		btn.textContent = "[ ... ]";
		try {
			const r = await fetch(GB_URL + "/post", {
				method: "POST",
				headers: { "Content-Type": "application/json" },
				body: JSON.stringify({ name: nameEl.value.trim() || "anon", msg }),
			});
			const j = await r.json();
			if (j.ok) {
				msgEl.value = "";
				load();
			} else {
				btn.textContent = "[ " + (j.error || "nope") + " ]";
			}
		} catch {
			btn.textContent = "[ offline ]";
		}
		setTimeout(() => (btn.textContent = "[ sign ]"), 2000);
	});

	load();
</script>

<script>
	document.querySelectorAll("[data-copy]").forEach((btn) => {
		btn.addEventListener("click", async () => {
			await navigator.clipboard.writeText(btn.dataset.copy);
			btn.textContent = "[ copied ]";
			setTimeout(() => (btn.textContent = "[ copy ]"), 1500);
		});
	});
</script>
