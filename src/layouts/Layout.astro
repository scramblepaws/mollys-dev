---
import "../styles/global.css";
import { marqueeText, site } from "../data/site";
import Icon from "../components/Icon.astro";
import Vinyl from "../components/Vinyl.astro";

interface Props {
	title: string;
}

const { title } = Astro.props;
const year = new Date().getFullYear();
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<title>{title}</title>
	</head>
	<body>
		<header class="top">
			<div class="brand">
				<span class="logo">mollys.dev</span>
				<span class="hello">hello world_<span class="cur blink">█</span></span>
			</div>
			<div class="mini-nav">
				[ <a href="/blog/">prev</a> ] [ <a href="/#contact">next</a> ]
			</div>
			<div class="announce" aria-hidden="true">
				<div class="announce-inner">
					<span>{marqueeText}</span><span>{marqueeText}</span>
				</div>
			</div>
		</header>

		<div class="cols">
			<aside class="side side-left">
				<div class="side-group">
					<div class="side-title">nav</div>
					<ul>
						<li>[ <a href="/">home</a> ]</li>
						<li>[ <a href="/blog/">blog</a> ]</li>
						<li>[ <a href="/#contact">contact</a> ]</li>
					</ul>
				</div>
				<div class="side-group">
					<div class="side-title">links</div>
					<ul>
						{
							site.steam.map((s, i) => (
								<li>
									<a class="icon-link" href={s} title={s}>
										<Icon name="steam" size={13} />
										steam {i + 1}
									</a>
								</li>
							))
						}
					</ul>
				</div>
				<div class="side-group">
					<div class="side-title">site info</div>
					<p>
						made by molly<br />
						© {year} mollys.dev
					</p>
				</div>
			</aside>

			<main class="center">
				<slot />
			</main>

			<aside class="side side-right">
				<div class="side-group">
					<div class="side-title">stats</div>
					<p>visitor no. <span class="counter">0000000</span></p>
				</div>
				<div class="side-group">
					<div class="side-title">badges</div>
					<div class="badges-row">
						<img class="badge-gif" src="/badges/hpvc-now.gif" width="88" height="31" alt="hosted on a very cool server" loading="lazy" />
						<img class="badge-gif" src="/badges/firefoxget.gif" width="88" height="31" alt="get firefox" loading="lazy" />
						<img class="badge-gif" src="/badges/antinazi.gif" width="88" height="31" alt="antinazi" loading="lazy" />
						<img class="badge-gif" src="/badges/hl.gif" width="88" height="31" alt="hl" loading="lazy" />
					</div>
				</div>
				<div class="side-group">
					<div class="side-title">media player</div>
					<div class="side-media">
						<Vinyl />
					</div>
				</div>
				<div class="side-group">
					<div class="side-title">updates</div>
					<p><span class="blink">■</span> under construction</p>
				</div>
				<div class="side-group">
					<div class="side-title">art</div>
					<div class="pixel-art">
						<div class="pixel-heart" aria-hidden="true"></div>
					</div>
				</div>
			</aside>
		</div>

		<footer class="site-foot">
			<div class="dots"></div>
			<p>this page is handmade. no frameworks were harmed. (ok, one framework)</p>
		</footer>

		<script>
			const n = (parseInt(localStorage.getItem("visits") || "0", 10) + 1).toString();
			localStorage.setItem("visits", n);
			document.querySelectorAll(".counter").forEach((el) => {
				el.textContent = (42000 + parseInt(n, 10)).toString().padStart(7, "0");
			});
		</script>
	</body>
</html>
