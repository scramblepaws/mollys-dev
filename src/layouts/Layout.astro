---
import "../styles/global.css";
import { marqueeText, site } from "../data/site";
import Icon from "../components/Icon.astro";
import Vinyl from "../components/Vinyl.astro";

interface Props {
	title: string;
}

const { title } = Astro.props;
const year = new Date().getFullYear();
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<title>{title}</title>
	</head>
	<body>
		<header class="top">
			<div class="brand">
				<span class="logo">mollys.dev</span>
			</div>
			<div class="announce" aria-hidden="true">
				<div class="announce-inner">
					<span>{marqueeText}</span><span>{marqueeText}</span>
				</div>
			</div>
		</header>

		<div class="cols">
			<aside class="side side-left">
				<div class="side-group">
					<div class="side-title">nav</div>
					<ul>
						<li>[ <a href="/">home</a> ]</li>
						<li>[ <a href="/blog/">blog</a> ]</li>
						<li>[ <a href="/#contact">contact</a> ]</li>
					</ul>
				</div>
				<div class="side-group">
					<div class="side-title">socials</div>
					<ul>
						<li>
							<Icon name="discord" size={12} /> {site.contact.discord}
						</li>
						<li>
							<Icon name="telegram" size={12} />{" "}
							<a href={site.contact.telegram}>t.me/MollyTech</a>
						</li>
						<li>
							<Icon name="session" size={12} />{" "}
							<button class="btn side-copy" data-copy={site.contact.session}>[ copy id ]</button>
						</li>
					</ul>
				</div>
				<div class="side-group">
					<div class="side-title">links</div>
					<ul>
						{
							site.steam.map((s, i) => (
								<li>
									<a class="icon-link" href={s} title={s}>
										<Icon name="steam" size={13} />
										steam {i + 1}
									</a>
								</li>
							))
						}
					</ul>
				</div>
				<div class="side-group">
					<div class="side-title">site info</div>
					<p>
						made by molly<br />
						© {year} mollys.dev
					</p>
				</div>
			</aside>

			<main class="center">
				<slot />
			</main>

			<aside class="side side-right">
				<div class="side-group">
					<div class="side-title">badges</div>
					<div class="badges-row">
						<img class="badge-gif" src="/badges/hpvc-now.gif" width="88" height="31" alt="hosted on a very cool server" loading="lazy" />
						<img class="badge-gif" src="/badges/firefoxget.gif" width="88" height="31" alt="get firefox" loading="lazy" />
						<img class="badge-gif" src="/badges/antinazi.gif" width="88" height="31" alt="antinazi" loading="lazy" />
						<img class="badge-gif" src="/badges/hl.gif" width="88" height="31" alt="hl" loading="lazy" />
						<img class="badge-gif" src="/badges/winrar4.gif" width="88" height="31" alt="winrar" loading="lazy" />
						<img class="badge-gif" src="/badges/tor.gif" width="88" height="31" alt="tor" loading="lazy" />
						<img class="badge-gif" src="/badges/tyg.gif" width="88" height="31" alt="tyg" loading="lazy" />
						<img class="badge-gif" src="/badges/webpassion.gif" width="88" height="31" alt="web passion" loading="lazy" />
					</div>
				</div>
				<div class="side-group">
					<div class="side-title">media player</div>
					<div class="side-media">
						<Vinyl />
					</div>
				</div>
				<div class="side-group">
					<div class="side-title">updates</div>
					<p><span class="blink">■</span> under construction</p>
				</div>
				<div class="side-group">
					<div class="side-title">art</div>
					<div class="pixel-art">
						<div class="pixel-heart" aria-hidden="true"></div>
					</div>
				</div>
			</aside>
		</div>

		<img
			class="anime-girl"
			src="/anime-girl.png"
			width="240"
			height="339"
			alt=""
			aria-hidden="true"
		/>

		<footer class="site-foot">
			<div class="dots"></div>
			<p>this page is handmade. no frameworks were harmed. (ok, one framework)</p>
		</footer>

		<script>
			document.querySelectorAll("[data-copy]").forEach((btn) => {
				btn.addEventListener("click", async () => {
					await navigator.clipboard.writeText(btn.dataset.copy);
					const original = btn.textContent;
					btn.textContent = "[ copied ]";
					setTimeout(() => (btn.textContent = original), 1500);
				});
			});

			const PREVIEW_API = "https://molly-counter.femfus.workers.dev/preview?url=";
			const cache = new Map();
			let tip = null;
			let timer = null;
			let active = null;

			const makeTip = () => {
				tip = document.createElement("div");
				tip.id = "link-preview";
				tip.style.display = "none";
				document.body.appendChild(tip);
			};

			const hide = () => {
				if (timer) clearTimeout(timer);
				timer = null;
				active = null;
				if (tip) tip.style.display = "none";
			};

			const show = (a, d) => {
				tip.replaceChildren();
				if (d.image) {
					const img = document.createElement("img");
					img.src = d.image;
					img.referrerPolicy = "no-referrer";
					img.onerror = () => img.remove();
					tip.appendChild(img);
				}
				const t = document.createElement("div");
				t.className = "lp-title";
				t.textContent = d.title;
				tip.appendChild(t);
				if (d.desc) {
					const p = document.createElement("div");
					p.className = "lp-desc";
					p.textContent = d.desc;
					tip.appendChild(p);
				}
				const host = document.createElement("div");
				host.className = "lp-host";
				host.textContent = new URL(d.url).hostname;
				tip.appendChild(host);
				tip.style.display = "block";
				const r = a.getBoundingClientRect();
				tip.style.left = Math.max(4, Math.min(r.left, window.innerWidth - 280)) + "px";
				tip.style.top = Math.min(r.bottom + 8, window.innerHeight - 140) + "px";
			};

			document.addEventListener("mouseover", (e) => {
				const a = e.target.closest("a[href]");
				if (!a || a === active) return;
				hide();
				const href = a.href;
				if (!href || !/^https?:/i.test(href) || href.includes(location.hostname)) return;
				active = a;
				timer = setTimeout(async () => {
					if (active !== a) return;
					let data = cache.get(href);
					if (data === undefined) {
						try {
							const r = await fetch(PREVIEW_API + encodeURIComponent(href));
							const j = await r.json();
							data = j.error ? null : j;
						} catch {
							data = null;
						}
						cache.set(href, data);
					}
					if (!data || active !== a) return;
					show(a, data);
				}, 350);
			});

			document.addEventListener("mouseout", (e) => {
				if (e.target.closest("a[href]")) hide();
			});
			window.addEventListener("scroll", hide);

			makeTip();
		</script>
	</body>
</html>
