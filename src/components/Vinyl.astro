---
---

<div class="vinyl-wrap">
	<div class="vinyl" id="vinyl">
		<div class="label"><span>mollys.dev</span></div>
		<div class="hole"></div>
	</div>
	<div class="np">
		<button class="btn" data-act="play">[ play ]</button>
		<button class="btn" data-act="stop">[ stop ]</button>
		<span>now playing: <span class="blink">nothing</span> (decorative)</span>
	</div>
</div>

<script>
	const v = document.getElementById("vinyl");
	document.querySelectorAll("[data-act]").forEach((b) => {
		b.addEventListener("click", () => {
			v.style.animationPlayState = b.dataset.act === "play" ? "running" : "paused";
		});
	});
</script>

<style>
	.vinyl-wrap {
		display: grid;
		place-items: center;
		padding: 6px 0 2px;
	}

	.vinyl {
		position: relative;
		display: grid;
		place-items: center;
		width: 150px;
		aspect-ratio: 1;
		border-radius: 50%;
		background:
			radial-gradient(circle at 50% 50%, #000 0 11%, transparent 11.5%),
			repeating-radial-gradient(circle at 50% 50%, #101010 0 1px, #1e1a1a 1px 3px);
		border: 1px solid #000;
		box-shadow: 0 0 10px rgba(183, 148, 246, 0.3);
		animation: spin 6s linear infinite;
	}

	.vinyl:hover {
		animation-play-state: paused;
	}

	.label {
		position: absolute;
		inset: 0;
		margin: auto;
		width: 34%;
		aspect-ratio: 1;
		border-radius: 50%;
		display: grid;
		place-items: center;
		background: var(--accent, #b794f6);
	}

	.label span {
		font: bold 8px "Courier New", Courier, monospace;
		color: var(--inverted, #140b2e);
		letter-spacing: 1px;
	}

	.hole {
		position: absolute;
		inset: 0;
		margin: auto;
		width: 4%;
		aspect-ratio: 1;
		border-radius: 50%;
		background: var(--bg, #0b0716);
	}

	.np {
		display: flex;
		align-items: center;
		gap: 6px;
		margin-top: 8px;
		font-size: 11px;
		color: var(--dim, #a896c9);
	}

	@keyframes spin {
		to {
			transform: rotate(360deg);
		}
	}
</style>
