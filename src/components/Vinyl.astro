---
---

<div class="player" id="player">
	<div class="art-box">
		<img id="np-art" class="np-art" src="" alt="" />
	</div>
	<div class="track-info">
		<div class="track-title" id="track-title">checking what molly is listening to...</div>
		<div class="progress"><div class="progress-fill" id="progress-fill"></div></div>
		<div class="times"><span id="time-cur">0:00</span><span id="time-dur">0:00</span></div>
		<div class="np-note">read-only — molly controls the aux</div>
	</div>
</div>

<script>
	const NP_URL = "https://molly-counter.femfus.workers.dev/now-playing";

	const art = document.getElementById("np-art");
	const titleEl = document.getElementById("track-title");
	const fill = document.getElementById("progress-fill");
	const timeCur = document.getElementById("time-cur");
	const timeDur = document.getElementById("time-dur");

	let data = null;
	let fetchedAt = 0;

	const fmt = (ms) => {
		const s = Math.floor((ms || 0) / 1000);
		return Math.floor(s / 60) + ":" + String(s % 60).padStart(2, "0");
	};

	const apply = () => {
		if (!data) return;
		titleEl.textContent = data.playing
			? "molly is listening to: " + data.title + (data.artist ? " — " + data.artist : "")
			: "molly isn't listening to anything rn";
		if (data.playing && data.art) {
			art.src = data.art;
			art.style.display = "";
		} else {
			art.style.display = "none";
		}
		timeDur.textContent = fmt(data.duration);
	};

	const tick = () => {
		if (!data || !data.playing || !data.duration) return;
		const pos = Math.min(data.duration, data.progress + (Date.now() - fetchedAt));
		fill.style.width = (pos / data.duration) * 100 + "%";
		timeCur.textContent = fmt(pos);
	};

	const poll = async () => {
		try {
			const r = await fetch(NP_URL);
			const j = await r.json();
			if (j.error) {
				titleEl.textContent =
					j.error === "not authed"
						? "molly hasn't linked spotify yet"
						: "now-playing error: " + j.error;
				return;
			}
			data = j;
			fetchedAt = Date.now();
			apply();
			tick();
		} catch {
			titleEl.textContent = "now-playing offline :(";
		}
	};

	poll();
	setInterval(tick, 1000);
	setInterval(poll, 15000);
</script>

<style>
	.player {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 8px;
		padding: 2px 0;
	}

	.art-box {
		width: 100px;
		height: 100px;
		border: 1px dotted var(--border, #6d4fb5);
		background: var(--bg, #0b0716);
		display: grid;
		place-items: center;
	}

	.np-art {
		width: 100%;
		height: 100%;
		object-fit: cover;
		display: block;
	}

	.track-info {
		width: 100%;
	}

	.track-title {
		font-size: 10px;
		margin-bottom: 4px;
		text-align: center;
	}

	.progress {
		width: 100%;
		height: 8px;
		border: 1px solid var(--border, #6d4fb5);
		background: var(--bg, #0b0716);
	}

	.progress-fill {
		height: 100%;
		width: 0%;
		background: var(--accent-dark, #5b3d99);
	}

	.times {
		display: flex;
		justify-content: space-between;
		font-size: 9px;
		color: var(--dim, #a896c9);
		margin: 2px 0 4px;
	}

	.np-note {
		font-size: 8px;
		text-align: center;
		color: var(--dim, #a896c9);
		letter-spacing: 1px;
	}
</style>
